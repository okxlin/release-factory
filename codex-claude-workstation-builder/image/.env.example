# codex-claude-workstation v2 build-time environment
# These are passed as --build-arg or through the CI workflow config.

# Node.js major version
NODE_MAJOR=24

# npm version or dist-tag
NPM_VERSION=latest

# Go version. Use "latest" to resolve go.dev's latest stable release at build time.
GO_VERSION=latest

# Rust version
RUST_VERSION=stable

# Bun and Deno versions. Use "latest" to install current stable releases.
BUN_VERSION=latest
DENO_VERSION=latest

# Package manager versions
PNPM_VERSION=latest
YARN_VERSION=stable

# Python quality tool versions
RUFF_VERSION=latest
BLACK_VERSION=latest
MYPY_VERSION=latest

# Space-separated code-server extension IDs
CODE_SERVER_EXTENSIONS="anthropic.claude-code openai.chatgpt ms-python.python charliermarsh.ruff redhat.vscode-yaml tamasfe.even-better-toml editorconfig.editorconfig esbenp.prettier-vscode dbaeumer.vscode-eslint ms-azuretools.vscode-docker ms-ceintl.vscode-language-pack-zh-hans"

# ── Runtime: inject at deploy time, never commit real values ──

# code-server password (required)
PASSWORD=change-me

# Root password (for su - root inside container)
ROOT_PASSWORD=codex2024

# Docker socket mount. Use /var/run/docker.sock to enable host Docker access.
DOCKER_SOCK_SRC=/dev/null

# Set true once if existing workspace files were created as root
FIX_WORKSPACE_OWNERSHIP_RECURSIVE=false

# Set true to make doctor.sh fail when the host/container runtime blocks
# unprivileged user namespace creation. Leave false for CI or restricted hosts.
CODEX_SANDBOX_STRICT=false
