# codex-claude-workstation v2 build-time environment
# These are passed as --build-arg or through the CI workflow config.

# Go version
GO_VERSION=1.25.11

# Rust version
RUST_VERSION=1.77.0

# Bun version
BUN_VERSION=1.3.14

# ── Runtime: inject at deploy time, never commit real values ──

# code-server password (required)
PASSWORD=change-me

# Root password (for su - root inside container)
ROOT_PASSWORD=codex2024

# Docker socket mount (leave empty to disable)
DOCKER_SOCK_SRC=/var/run/docker.sock
