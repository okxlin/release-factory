# Public browser origin. Required. Use an origin only; subpaths are unsupported.
PUBLIC_URL=https://dsh.example.com

# Authentication mode: caddy-security (default), none, or reserved dsh mode.
AUTH_MODE=caddy-security
AUTH_USERNAME=admin

# Set exactly one credential source. Prefer a deployment secret or password file.
AUTH_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# AUTH_PASSWORD_FILE=/run/secrets/dsh_password
# AUTH_PASSWORD_HASH=bcrypt:12:$2b$12$...

# Login token and cookie lifetime in seconds (300-2592000). caddy-security
# does not renew the access token automatically; expiry requires a new login.
AUTH_TOKEN_LIFETIME=3600

# Space-separated CIDRs for every proxy hop Caddy should trust while resolving
# X-Forwarded-For from right to left. The default is safe only while PORT stays
# behind the documented loopback/private reverse proxy. Use "none" when Caddy
# receives client connections directly. Add CDN ranges or normalize the client
# IP in the outer proxy before enabling IP-based limits. Unrestricted /0 ranges
# are rejected because they would let arbitrary peers spoof the rate-limit key.
# The username/password rate-limit budgets themselves are fixed in Caddyfile;
# change and rebuild the image to alter those budgets.
CADDY_TRUSTED_PROXIES=private_ranges

# Keep false for HTTPS domain deployments. true is only for isolated HTTP tests
# and causes caddy-security cookies to lose both Secure and HttpOnly.
AUTH_COOKIE_INSECURE=false

# Optional comma-separated additional DSH Host authorities.
DSH_TRUSTED_HOSTS=

# Runtime ports. Publish PORT only through a loopback-bound host port or a
# private Docker network; DSH_INTERNAL_PORT stays inside the container.
PORT=8080
DSH_INTERNAL_PORT=3080

# Conservative Caddy runtime defaults. These do not cap DSH workload memory.
GOMEMLIMIT=128MiB
GOMAXPROCS=2
DSH_TELEMETRY_DISABLED=1
