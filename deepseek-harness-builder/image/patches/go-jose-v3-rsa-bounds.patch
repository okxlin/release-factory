diff --git a/release_factory_headers_test.go b/release_factory_headers_test.go
new file mode 100644
--- /dev/null
+++ b/release_factory_headers_test.go
@@ -0,0 +1,96 @@
+package jose
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	josejson "github.com/go-jose/go-jose/v3/json"
+)
+
+func TestReleaseFactoryEmbeddedKeys(t *testing.T) {
+	marshal := func(value interface{}) []byte {
+		t.Helper()
+		data, err := json.Marshal(value)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return data
+	}
+	private, err := fromRsaPrivateKey(rsaTestKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	public := fromRsaPublicKey(&rsaTestKey.PublicKey)
+	stray := fromRsaPublicKey(&rsaTestKey.PublicKey)
+	stray.P, stray.Q = private.P, private.Q
+	for _, fixture := range []struct {
+		name    string
+		key     *rawJSONWebKey
+		private bool
+	}{
+		{"public", public, false}, {"private", private, true},
+		{"stray-private", stray, true}, {"symmetric", &rawJSONWebKey{Kty: "oct", K: newBuffer([]byte("secret"))}, true},
+	} {
+		for _, unprotected := range []bool{false, true} {
+			header := map[string]interface{}{"alg": "RS256"}
+			var extra map[string]interface{}
+			if unprotected {
+				extra = map[string]interface{}{"jwk": fixture.key, "kid": "from-unprotected"}
+			} else {
+				header["jwk"] = fixture.key
+			}
+			protected := base64.RawURLEncoding.EncodeToString(marshal(header))
+			signature := map[string]interface{}{"protected": protected, "signature": "dGVzdA"}
+			if unprotected {
+				signature["header"] = extra
+			}
+			flattened := map[string]interface{}{"payload": "dGVzdA", "protected": protected, "signature": "dGVzdA"}
+			if unprotected {
+				flattened["header"] = extra
+			}
+			messages := map[string]string{
+				"flattened": string(marshal(flattened)),
+				"general":   string(marshal(map[string]interface{}{"payload": "dGVzdA", "signatures": []interface{}{signature}})),
+			}
+			if !unprotected {
+				messages["compact"] = protected + ".dGVzdA.dGVzdA"
+			}
+			for format, message := range messages {
+				parsed, err := ParseSigned(message)
+				if fixture.private {
+					if err == nil || !strings.Contains(err.Error(), "JWK contains private parameters") {
+						t.Errorf("%s/%s/unprotected=%t: private parameters were not rejected before key validation: %v", fixture.name, format, unprotected, err)
+					}
+				} else if err != nil {
+					t.Errorf("%s: public key rejected: %v", format, err)
+				} else if unprotected && (parsed.Signatures[0].Header.KeyID != "from-unprotected" || parsed.Signatures[0].Unprotected.KeyID != "from-unprotected") {
+					t.Errorf("%s: unprotected public header was not retained", format)
+				}
+			}
+		}
+	}
+	privateEPK := josejson.RawMessage(marshal(private))
+	if _, err := (rawHeader{headerEPK: &privateEPK}).getEPK(); err == nil || !strings.Contains(err.Error(), "JWK contains private parameters") {
+		t.Errorf("private EPK was not rejected before validation: %v", err)
+	}
+	publicEPK := josejson.RawMessage(marshal(public))
+	if _, err := (rawHeader{headerEPK: &publicEPK}).getEPK(); err != nil {
+		t.Errorf("public EPK rejected: %v", err)
+	}
+}
+
+// getJWK is used only by signer tests.
+func (parsed rawHeader) getJWK() (*JSONWebKey, error) {
+	v := parsed[headerJWK]
+	if v == nil {
+		return nil, nil
+	}
+	var jwk *JSONWebKey
+	err := josejson.Unmarshal(*v, &jwk)
+	if err != nil {
+		return nil, err
+	}
+	return jwk, nil
+}
diff --git a/release_factory_rsa_test.go b/release_factory_rsa_test.go
new file mode 100644
--- /dev/null
+++ b/release_factory_rsa_test.go
@@ -0,0 +1,78 @@
+package jose
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/base64"
+	"encoding/json"
+	"math/big"
+	"strings"
+	"testing"
+)
+
+// Regressions for GHSA-mgcc-cww5-fp2q, backported from the v4.1.6 fix.
+func TestReleaseFactoryRSABounds(t *testing.T) {
+	encode := func(bits int) string {
+		n := new(big.Int).Lsh(big.NewInt(1), uint(bits-1))
+		return base64.RawURLEncoding.EncodeToString(n.SetBit(n, 0, 1).Bytes())
+	}
+	for _, bits := range []int{4095, 4096, 4097} {
+		raw, err := json.Marshal(map[string]string{"kty": "RSA", "n": encode(bits), "e": "AQAB"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		var key JSONWebKey
+		err = json.Unmarshal(raw, &key)
+		if bits <= 4096 && err != nil {
+			t.Errorf("valid %d-bit public key rejected: %v", bits, err)
+		}
+		if bits > 4096 && (err == nil || !strings.Contains(err.Error(), "modulus too large")) {
+			t.Errorf("oversized %d-bit modulus was not rejected before validation: %v", bits, err)
+		}
+	}
+	for _, parameters := range []map[string]string{
+		{"kty": "RSA", "n": encode(4097), "e": "AQAB", "d": "Aw", "p": "Aw", "q": "Aw"},
+		{"kty": "RSA", "n": encode(2049), "e": "AQAB", "d": "Aw", "p": encode(16384), "q": "Aw"},
+	} {
+		raw, err := json.Marshal(parameters)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var key JSONWebKey
+		err = json.Unmarshal(raw, &key)
+		want := "modulus too large"
+		if parameters["n"] == encode(2049) {
+			want = "p * q != n"
+		}
+		if err == nil || !strings.Contains(err.Error(), want) {
+			t.Errorf("private RSA bounds were not checked before validation: want %q, got %v", want, err)
+		}
+	}
+}
+
+func TestReleaseFactoryRSASignature(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := json.Marshal(JSONWebKey{Key: key})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var parsed JSONWebKey
+	if err := json.Unmarshal(raw, &parsed); err != nil {
+		t.Fatal(err)
+	}
+	signer, err := NewSigner(SigningKey{Algorithm: RS256, Key: parsed.Key}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	signed, err := signer.Sign([]byte("release-factory RSA compatibility"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	payload, err := signed.Verify(&key.PublicKey)
+	if err != nil || string(payload) != "release-factory RSA compatibility" {
+		t.Fatalf("normal RSA signature failed: %s, %v", payload, err)
+	}
+}
