# codex-web-workstation v2 build-time environment
# These are passed as --build-arg or through the CI workflow config.
# Runtime secrets are never baked into the image; inject them at deploy time.

# Root password (change in production)
ROOT_PASSWORD=root

# Go version
GO_VERSION=1.22.5

# Rust version
RUST_VERSION=1.77.0

# Bun version
BUN_VERSION=1.3.14

# ── Runtime: inject at deploy time, never commit real values. ──
# Recommended: use .env file (not this .env.example) and pass through
# your deploy system (docker run -e, compose env_file, etc.).

# code-server password (required)
PASSWORD=change-me

# Codex auth mode: device-auth | api-key | access-token | none (default: device-auth)
CODEX_AUTH_MODE=device-auth

# OpenAI API Key (only needed for CODEX_AUTH_MODE=api-key)
OPENAI_API_KEY=

# Custom provider (third-party Responses API endpoint)
ENABLE_CUSTOM_PROVIDER=false
CUSTOM_PROVIDER_NAME=
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_MODEL=
CUSTOM_PROVIDER_ENV_KEY=

# Docker socket mount (enable Docker-in-Docker)
ENABLE_DOCKER_SOCK=false

# Happy remote control
ENABLE_HAPPY_REMOTE=false
HAPPY_SERVER_URL=

